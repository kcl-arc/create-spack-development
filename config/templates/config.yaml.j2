# Spack config for the user-cloneable {{ spack_config_basename }}
# install_prefix, source_cache_path from setup script
# environments_root is the repo's git-managed environments/ dir: each
# environments/<name>/spack.yaml is the Spack environment <name>.
config:
  environments_root: {{ envs_dir }}
  install_tree:
    root: {{ install_prefix }}/apps
    projections:
      all: "{architecture}/{compiler.name}-{compiler.version}/{name}-{version}-{hash}"

  template_dirs:
    - {{ install_prefix }}

  # build_stage lives under the repo's var/, which every job binds into the container,
  # so build failures leave a stage/log that is visible from the host on any node,
  # unlike $tempdir which is the container's private, ephemeral /tmp.
  build_stage:
    - {{ build_stage_path }}
    - $tempdir/$user/spack-stage

  test_stage: $user_cache_path/test
  source_cache: {{ source_cache_path }}
  misc_cache: $user_cache_path/cache
  connect_timeout: 10
  verify_ssl: true
  suppress_gpg_warnings: false
  install_missing_compilers: false
  checksum: true
  deprecated: false
  dirty: false
  build_language: C
  locks: true
  url_fetch_method: urllib
  ccache: false
  concretizer: clingo
  # Short lock timeouts produced read-lock failures under concurrent jobs, and
  # the SPACK_CONFIG_LOCK_TIMEOUT env var previously exported by job templates
  # is not a real Spack override (did nothing). These keys are the only thing
  # that governs locking.
  db_lock_timeout: 300
  package_lock_timeout: 300
  shared_linking:
    type: rpath
    bind: false
  allow_sgid: true
