# Spack environment "{{ environment_name }}", created by new_env.py.
# Add root specs under specs:, then ./spack_build.py -e {{ environment_name }}.
# paths.yaml (generated, gitignored) sets the install tree and module root:
# keep the include, and don't set config:install_tree or modules:*:roots here.
spack:
  include:
  - paths.yaml
  specs: []
  view: false
  concretizer:
    unify: false
    reuse: false
  modules:
    default:
      enable: [tcl]
      tcl:
        all:
          autoload: direct
        hash_length: 0
        naming_scheme: '{name}/{version}-{compiler.name}-{compiler.version}'
