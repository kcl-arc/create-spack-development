# create-spack-packages checkout (branch recorded by setup.py) first, so custom
# packages take precedence; builtin from spack-packages git, pinned.
# The destination keeps the builtin clone outside the container so jobs do not
# re-clone it each run.
repos:
  local_packages: {{ local_packages_path }}
  builtin:
    git: https://github.com/spack/spack-packages.git
    tag: v2026.06.0
    destination: {{ builtin_destination }}
