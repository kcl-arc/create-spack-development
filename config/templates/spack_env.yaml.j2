# Spack environment manifest, rendered by setup.py for "{{ environment_name }}".
# Add root specs under specs: (or use `spack -e {{ environment_name }} add <spec>`),
# then run ./spack_concretize.py, ./spack_pkgs_install.py and ./spack_mod_refresh.py.
# The per-env install tree and module root keep the environment self-contained:
# rm -rf {{ env_install_root }} removes everything it ever wrote.
spack:
  specs: []
  view: false
  concretizer:
    unify: false
    reuse: {{ reuse }}
  config:
    install_tree:
      root: {{ env_install_root }}/apps
      projections:
        all: "{architecture}/{compiler.name}-{compiler.version}/{name}-{version}-{hash}"
  modules:
    default:
      enable: [tcl]
      roots:
        tcl: {{ env_install_root }}/modules
      tcl:
        all:
          autoload: direct
        hash_length: 0
        naming_scheme: '{name}/{version}-{compiler.name}-{compiler.version}'
