#!/bin/bash
#
# One-off job: create a Spack environment inside the Singularity image.
# Used by setup.py because Singularity is not available on login nodes.
#

#SBATCH --partition={{ partition }}
{{ slurm_args }}

export SPACK_USER_CONFIG_PATH={{ spack_user_config_path }}
export SPACK_CONFIG_LOCK_TIMEOUT=300

{% set sif = sif_path | default("/software/containers/singularity/spack/spack_v1_1_1.sif") %}
{% set spack_cmd = spack_in_container | default("/opt/spack/bin/spack") %}

singularity exec \
  --bind {{ framework_dir }}:{{ framework_dir }} \
  --bind {{ spack_user_config_path }}:{{ spack_user_config_path }} \
  --bind {{ repo_dir }}:{{ repo_dir }} \
  --bind {{ outputs_dir }}:{{ outputs_dir }} \
  {{ sif }} {{ spack_cmd }} env create {{ environment_name_shell }}
